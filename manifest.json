                    "src": "icons/file-handler-96x96.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ],
            "launch_type": "single-client"
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "web+gymtracker",
            "url": "./?data=%s"
        }
    ],
    "share_target": {
        "action": "./",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "id": "gym-tracker-pwa",
    "start_url": "./?source=pwa",
    "scope": "./",
    "description": "A comprehensive gym workout tracker that works completely offline. Log exercises, track progress with charts, and use the built-in rest timer. Perfect for serious gym enthusiasts.",
    "features": [
        "Cross Platform",
        "Fast",
        "Simple"
    ],
    "custom": {
        "offline": true,
        "ios_compatible": true,
        "android_compatible": true,
        "desktop_compatible": true
    }
}